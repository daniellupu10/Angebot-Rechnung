---
 css/style.css | 26 ++++++++-------
 index.html    |  5 ++-
 js/app.js     | 87 ++++++++++++++++++++++++++++++++++-----------------
 3 files changed, 76 insertions(+), 42 deletions(-)

diff --git a/css/style.css b/css/style.css
