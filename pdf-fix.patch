     }
 
+    .app-container,
+    #app-main-shell,
     .neu-sidebar, 
     .neu-canvas, 
     .catalog-modal-backdrop, 
@@ -1086,7 +1088,7 @@ body {
         max-width: 100% !important;
         min-height: auto !important;
         padding: 12mm 15mm !important;
