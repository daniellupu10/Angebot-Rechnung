     background: #ffffff;
     color: #333333;
     font-family: Arial, Helvetica, sans-serif;
     font-size: 11pt;
     line-height: 1.4;
-    padding: 40px;
+    padding: 28px 36px 20px 36px;
     box-sizing: border-box;
 }
 
 .clean-header {
     display: flex;
     justify-content: space-between;
-    margin-bottom: 45px;
+    margin-bottom: 24px;
 }
 
 .clean-company-info {
@@ -783,7 +783,7 @@ body {
 }
 
 .clean-client-address {
-    margin-bottom: 35px;
